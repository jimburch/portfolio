---
import { getEntry } from 'astro:content';
import BackLayout from '../layouts/BackLayout.astro';
import { Content as AboutCopy } from '../copy/about.md';

const now = await getEntry('now', 'current');
const nowProject = now && (await getEntry(now.data.project));
---

<BackLayout title="About" heading="About">
  <AboutCopy />

  {
    now && (
      <section aria-labelledby="now-heading">
        <h2 id="now-heading">What I'm into now</h2>
        <p>{now.data.blurb}</p>
        {nowProject && (
          <p>
            <a href={`/projects/${nowProject.id}`}>Read the {nowProject.data.title} build log</a>
          </p>
        )}
      </section>
    )
  }
</BackLayout>
