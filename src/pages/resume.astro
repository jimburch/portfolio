---
import { getCollection } from 'astro:content';
import BackLayout from '../layouts/BackLayout.astro';
import WorkEntry from '../components/back/WorkEntry.astro';
import ResumeLinks from '../components/back/ResumeLinks.astro';
import ContactLinks from '../components/back/ContactLinks.astro';
import { frontmatter as about } from '../copy/about.md';
import { byOrder } from '../data/order';

const work = (await getCollection('work')).sort(byOrder);
const summary: string = about.summary;
---

<BackLayout title="Resume" heading="Resume">
  <ResumeLinks />
  <p class="lede">{summary}</p>

  <section aria-labelledby="work-heading">
    <h2 id="work-heading">Work</h2>
    {work.map((entry) => <WorkEntry entry={entry} />)}
  </section>

  <section aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <p>Hack Reactor · Software engineering program · 2021</p>
    <p>TODO(jim): confirm, and add anything else you want listed.</p>
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <p>TODO(jim)</p>
  </section>

  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>
    <ContactLinks />
  </section>
</BackLayout>
