---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ProblemSection from "../components/ProblemSection.astro";
import WhatIBuildSection from "../components/WhatIBuildSection.astro";
import DealSection from "../components/DealSection.astro";
import AboutSection from "../components/AboutSection.astro";
import CtaSection from "../components/CtaSection.astro";
import MobileStickyCtaBar from "../components/MobileStickyCtaBar.tsx";
---

<Layout title="Jim Burch | MVP Builder for Founders">
  <main id="main">
    <Hero />

    <Section id="problem" dark>
      <ProblemSection />
    </Section>

    <Section id="what-i-build">
      <WhatIBuildSection />
    </Section>

    <Section id="the-deal" dark>
      <DealSection />
    </Section>

    <Section id="about">
      <AboutSection />
    </Section>

    <Section id="cta" dark>
      <CtaSection />
    </Section>
  </main>

  <MobileStickyCtaBar client:load />
</Layout>
