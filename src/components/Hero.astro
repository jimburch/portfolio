---
import CalButton from "./CalButton.tsx";
import FadeIn from "./FadeIn.tsx";
import RetroGrid from "./RetroGrid.tsx";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center px-6 bg-[var(--color-surface-0)] overflow-hidden"
>
  <!-- Three.js retro grid background -->
  <RetroGrid client:visible />

  <!-- Bottom fade to blend hero into next section -->
  <div
    class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[var(--color-surface-1)]/30 to-transparent pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-4xl mx-auto text-center">
    <!-- Top framing line -->
    <div
      class="h-px w-full max-w-xl mx-auto bg-gradient-to-r from-transparent via-[var(--color-accent)]/20 to-transparent mb-10"
      aria-hidden="true"
    >
    </div>

    <FadeIn client:load delay={0}>
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white">
        Your MVP needs to survive&nbsp;<span class="text-[var(--color-accent)] neon-glow">success.</span>
      </h1>
    </FadeIn>

    <FadeIn client:load delay={0.1}>
      <p
        class="mt-6 text-xl text-neutral-400 max-w-2xl mx-auto leading-relaxed"
      >
        I build production-ready MVPs for founders. Clean code, real security,
        scalable architecture. No hourly rate. I take equity instead.
      </p>
    </FadeIn>

    <FadeIn client:load delay={0.2}>
      <div class="mt-10">
        <CalButton
          client:load
          className="bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-rose)] text-white font-semibold px-8 py-3 rounded-lg hover:opacity-90 transition-opacity cursor-pointer cta-glow"
        >
          Let's talk about your idea →
        </CalButton>
      </div>
    </FadeIn>

    <FadeIn client:load delay={0.3}>
      <p class="mt-8 font-mono text-sm text-neutral-400">
        React · Node · PostgreSQL · 5+ years building production software
      </p>
    </FadeIn>

    <!-- Bottom framing line -->
    <div
      class="h-px w-full max-w-xl mx-auto bg-gradient-to-r from-transparent via-[var(--color-accent)]/20 to-transparent mt-10"
      aria-hidden="true"
    >
    </div>
  </div>
</section>
