---
interface Props {
  number: number;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<div>
  <span class="text-5xl font-bold font-mono text-[var(--color-accent)]/20">{number}</span>
  <h3 class="mt-2 text-lg font-semibold text-white">{title}</h3>
  <p class="mt-2 text-neutral-400 leading-relaxed">{description}</p>
</div>
