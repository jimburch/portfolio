---
interface Props {
  id: string;
  dark?: boolean;
  narrow?: boolean;
  noDivider?: boolean;
}

const { id, dark = false, narrow = false, noDivider = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    "relative px-6 py-24 md:py-32",
    dark ? "bg-[var(--color-surface-0)]" : "bg-[var(--color-surface-1)]/30",
  ]}
>
  {
    !noDivider && (
      <div
        class="absolute top-0 left-0 right-0 -translate-y-px"
        aria-hidden="true"
      >
        <div class="h-px w-full bg-gradient-to-r from-transparent via-[var(--color-accent)]/25 to-transparent" />
      </div>
    )
  }
  <div class:list={["mx-auto", narrow ? "max-w-2xl" : "max-w-4xl"]}>
    <slot />
  </div>
</section>
