---
import '../../styles/badge-front.css';
import { SITE } from '../../data/site';
import Avatar from './Avatar.astro';
import StaticMenu from './StaticMenu.astro';
---

<div id="badge" data-side="front">
  <main class="face-front">
    <div class="topline">
      <p class="silk dev-hint" data-part="dev-hint">psst… ← ← A</p>
      <div class="lanyard" data-part="lanyard" aria-hidden="true"></div>
      <button class="pressable reset" type="button" data-action="reset" aria-label="Reset badge" data-part="reset">
        <span class="cap key-surface"></span>
        <span class="silk">RESET</span>
      </button>
    </div>

    <header class="id">
      <h1 class="name" data-part="name">{SITE.name}</h1>
      <p class="role" data-part="role">{SITE.roleLine}</p>
    </header>

    <Avatar />

    <div class="controls" data-part="controls">
      <div class="ab">
        <button class="pressable round b" type="button" data-input="b" aria-label="B button">
          <span class="cap metal"></span><span class="silk">B</span>
        </button>
        <button class="pressable round a" type="button" data-input="a" aria-label="A button">
          <span class="cap metal"></span><span class="silk">A</span>
        </button>
      </div>
      <div class="pills">
        <button class="pressable pill" type="button" data-input="select">
          <span class="cap metal"></span><span class="silk">SELECT</span>
        </button>
        <button class="pressable pill" type="button" data-input="start">
          <span class="cap metal"></span><span class="silk">START</span>
        </button>
      </div>
      <div class="dpad">
        <button class="pressable up" type="button" data-input="up" aria-label="D-pad up"><span class="cap metal"></span></button>
        <button class="pressable left" type="button" data-input="left" aria-label="D-pad left"><span class="cap metal"></span></button>
        <button class="pressable right" type="button" data-input="right" aria-label="D-pad right"><span class="cap metal"></span></button>
        <button class="pressable down" type="button" data-input="down" aria-label="D-pad down"><span class="cap metal"></span></button>
      </div>
    </div>

    <a class="pressable metal resume-pad" href="/resume" data-flip data-no-permission data-part="resume-pad">RESUME ↻</a>

    <div class="case" data-part="case">
      <div id="lcd" data-part="lcd" role="region" aria-label="Badge screen">
        <div id="lcd-screen">
          <StaticMenu />
        </div>
      </div>
      <div class="case-side">
        <button class="pressable key" type="button" data-input="up" data-case aria-label="Case up"><span class="cap key-surface"></span></button>
        <button class="pressable key" type="button" data-input="down" data-case aria-label="Case down"><span class="cap key-surface"></span></button>
      </div>
      <div class="case-keys">
        <button class="pressable key" type="button" data-input="left" data-case aria-label="Case left"><span class="cap key-surface"></span></button>
        <button class="pressable key" type="button" data-input="a" data-case aria-label="Case A"><span class="cap key-surface"></span></button>
        <button class="pressable key" type="button" data-input="right" data-case aria-label="Case right"><span class="cap key-surface"></span></button>
      </div>
    </div>
  </main>

  <div id="back-slot" class="face-back" aria-hidden="true" hidden></div>
</div>
