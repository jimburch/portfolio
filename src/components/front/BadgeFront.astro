---
import '../../styles/badge-front.css';
import { SITE } from '../../data/site';
import Avatar from './Avatar.astro';
import StaticMenu from './StaticMenu.astro';
import HeldView from '../scene/HeldView.astro';
---

<div id="badge" data-side="front">
  <main class="face-front">
    <div class="topline">
      <p class="silk dev-hint" data-part="dev-hint">psst… ← ← A</p>
      <div class="lanyard" data-part="lanyard" aria-hidden="true"></div>
      <button class="pressable reset" type="button" data-action="reset" aria-label="Reset badge" data-part="reset">
        <span class="cap key-surface"></span>
        <span class="silk">RESET</span>
      </button>
    </div>

    <header class="id">
      <h1 class="name" data-part="name">{SITE.name}</h1>
      <p class="role" data-part="role">{SITE.roleLine}</p>
    </header>

    <Avatar />

    <!-- Plain board, kept clear for something Jim will decide on later. -->
    <div class="reserved" data-part="reserved" aria-hidden="true"></div>

    <a class="pressable metal resume-pad" href="/resume" data-flip data-no-permission data-part="resume-pad">RESUME <span aria-hidden="true">↻</span></a>

    <div class="case" data-part="case">
      <div id="lcd" data-part="lcd" role="region" aria-label="Badge screen">
        <div id="lcd-screen">
          <StaticMenu />
        </div>
      </div>
      <div class="case-side">
        <button class="pressable key" type="button" data-input="up" aria-label="Case up"><span class="cap key-surface"></span><span class="silk key-silk" aria-hidden="true">▲</span></button>
        <button class="pressable key" type="button" data-input="down" aria-label="Case down"><span class="cap key-surface"></span><span class="silk key-silk" aria-hidden="true">▼</span></button>
      </div>
      <div class="case-keys">
        <button class="pressable key" type="button" data-input="left" aria-label="Case left"><span class="cap key-surface"></span><span class="silk key-silk" aria-hidden="true">◀&#xFE0E;</span></button>
        <button class="pressable key" type="button" data-input="a" aria-label="Case A"><span class="cap key-surface"></span><span class="silk key-silk" aria-hidden="true">A</span></button>
        <button class="pressable key" type="button" data-input="right" aria-label="Case right"><span class="cap key-surface"></span><span class="silk key-silk" aria-hidden="true">▶&#xFE0E;</span></button>
      </div>
    </div>
  </main>

  <!-- A back page's face is lifted in here, after the held close-up (shown
       only on a qualifying desktop): the same markup a back page has, so the
       landed back is laid out exactly like a direct load of it. -->
  <div id="back-slot" class="face-back" aria-hidden="true" hidden>
    <HeldView />
  </div>
</div>
