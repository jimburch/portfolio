---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex flex-col border border-neutral-800 rounded-2xl bg-neutral-900/50 p-6 md:p-8">
  <div class="mb-4 w-12 h-12 rounded-xl bg-teal-300/[0.08] border border-teal-300/15 flex items-center justify-center shrink-0">
    <slot name="icon" />
  </div>
  <h3 class="text-lg font-semibold text-white">{title}</h3>
  <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
    <slot />
  </p>
</div>
