---
import FadeIn from "./FadeIn.tsx";
---

<div>
  <FadeIn client:visible>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center">
      What your startup looks like after we&nbsp;ship.
    </h2>
  </FadeIn>

  <div class="mt-12 flex flex-col gap-4">
    <!-- Outcome 1: Hire-ready codebase -->
    <FadeIn client:visible>
      <div class="border border-neutral-800 rounded-2xl bg-neutral-900/50 p-6 md:p-8">
        <h3 class="text-xl font-semibold text-white">
          Your first hire ships on day one.
        </h3>
        <p class="mt-3 text-neutral-400 leading-relaxed">
          Component structure, API design, and database schemas that make sense
          to the next developer who touches the code. Tests that catch
          regressions before they reach users. Documentation that gets a new
          engineer productive in days, not weeks. Infrastructure that
          scales without surprise bills.
        </p>
      </div>
    </FadeIn>

    <!-- Outcome 2: Security -->
    <FadeIn client:visible>
      <div class="border border-neutral-800 rounded-2xl bg-neutral-900/50 p-6 md:p-8">
        <h3 class="text-xl font-semibold text-white">
          Your users' data stays safe.
        </h3>
        <p class="mt-3 text-neutral-400 leading-relaxed">
          Proper authentication, input validation, and environment-based secrets
          management from the start. Not afterthoughts bolted on after a
          breach. Defaults baked into the architecture.
        </p>
      </div>
    </FadeIn>

    <!-- Outcome 3: Investor-ready -->
    <FadeIn client:visible>
      <div class="border border-neutral-800 rounded-2xl bg-neutral-900/50 p-6 md:p-8">
        <h3 class="text-xl font-semibold text-white">
          Investors see a technical co-founder, not a Lovable&nbsp;URL.
        </h3>
        <p class="mt-3 text-neutral-400 leading-relaxed mb-6">
          When investors ask "who built this?", your answer matters more than
          your pitch deck.
        </p>

        <div class="grid md:grid-cols-2 gap-4">
          <div class="rounded-xl border border-red-500/20 bg-red-500/5 p-6">
            <p class="text-sm font-medium text-red-400 mb-2">
              What investors see
            </p>
            <p class="text-neutral-300 font-semibold">"Built on Lovable"</p>
            <p class="mt-1 text-sm text-neutral-500">
              No technical co-founder. No architecture. No tests.
            </p>
          </div>
          <div class="rounded-xl border border-teal-300/20 bg-teal-300/5 p-6">
            <p class="text-sm font-medium text-teal-300 mb-2">
              What investors want to see
            </p>
            <p class="text-neutral-300 font-semibold">
              "Technical co-founder, production codebase"
            </p>
            <p class="mt-1 text-sm text-neutral-500">
              CI/CD pipeline. Test coverage. Clean architecture.
            </p>
          </div>
        </div>

        <p class="mt-6 text-lg text-neutral-300 leading-relaxed text-center">
          I'm not just building your MVP. I'm giving you a technical story you
          can tell with confidence.
        </p>
      </div>
    </FadeIn>
  </div>
</div>
