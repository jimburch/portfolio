---
import FadeIn from "./FadeIn.tsx";
---

<div>
  <FadeIn client:visible>
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center">
      Investors notice what's under the&nbsp;hood.
    </h2>
    <p class="mt-4 text-lg text-neutral-400 leading-relaxed text-center">
      When investors ask "who built this?" — your answer matters more than your pitch deck.
    </p>
  </FadeIn>

  <FadeIn client:visible>
    <div class="mt-10 grid md:grid-cols-2 gap-4">
      <div class="rounded-xl border border-red-500/20 bg-red-500/5 p-6">
        <p class="text-sm font-medium text-red-400 mb-2">What investors see</p>
        <p class="text-neutral-300 font-semibold">"Built on Lovable"</p>
        <p class="mt-1 text-sm text-neutral-500">
          No technical co-founder. No architecture. No tests.
        </p>
      </div>
      <div class="rounded-xl border border-teal-300/20 bg-teal-300/5 p-6">
        <p class="text-sm font-medium text-teal-300 mb-2">
          What investors want to see
        </p>
        <p class="text-neutral-300 font-semibold">
          "Technical co-founder, production codebase"
        </p>
        <p class="mt-1 text-sm text-neutral-500">
          CI/CD pipeline. Test coverage. Clean architecture.
        </p>
      </div>
    </div>
  </FadeIn>

  <FadeIn client:visible>
    <p class="mt-8 text-lg text-neutral-300 leading-relaxed text-center">
      I'm not just building your MVP. I'm giving you a technical story you can
      tell with confidence.
    </p>
  </FadeIn>
</div>
